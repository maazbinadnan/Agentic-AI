# ─── Azure AI Foundry ────────────────────────────────────────────────────────
# Required: your Azure AI Foundry project endpoint
AZURE_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project-id>

# ─── Agent Configuration ──────────────────────────────────────────────────────
# Optional: model to use for both agents (default: gpt-4o-mini)
AGENT_MODEL=gpt-4o-mini

# ─── RL Loop Configuration ───────────────────────────────────────────────────
# Optional: minimum score (0-10) to consider user stories acceptable (default: 8)
PASS_THRESHOLD=8
